<Project>
  <!--
    解决方案级编译约定。
    统一可空引用、文档生成与程序集元数据，避免各项目各自漂移。
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Zeus Contributors</Authors>
    <Company>Zeus</Company>
    <Product>Zeus</Product>
    <Description>面向 .NET 的 UI 无关上位机开发框架。把复杂留给 Zeus，把简单留给用户。</Description>
    <Copyright>Copyright © Zeus</Copyright>
    <Version>0.4.0</Version>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>zeus;host;modbus;serial;tcp;winforms;wpf;industrial;scada</PackageTags>
    <PackageReleaseNotes>0.4.0：新增 Modbus 功能码 17 读写多个保持寄存器；新增 UDP 服务端通道与 JSON type udp-server；新增 ChannelTraceLogger 结构化报文日志；WinForms/WPF 新增 BindEnabled。</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Mokode-dev/Zeus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mokode-dev/Zeus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
