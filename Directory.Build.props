<Project>
  <!--
    解决方案级编译约定。
    统一可空引用、文档生成与程序集元数据，避免各项目各自漂移。
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Zeus Contributors</Authors>
    <Company>Zeus</Company>
    <Product>Zeus</Product>
    <Description>面向 .NET 的 UI 无关上位机开发框架。把复杂留给 Zeus，把简单留给用户。</Description>
    <Copyright>Copyright © Zeus</Copyright>
    <Version>0.8.0</Version>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>zeus;host;modbus;mitsubishi;mc;siemens;s7;omron;fins;ethernet-ip;cip;allen-bradley;serial;tcp;udp;winforms;wpf;industrial;scada</PackageTags>
    <PackageReleaseNotes>0.8.0：新增 Allen-Bradley EtherNet/IP CIP 协议栈、CIP 标签读写、虚拟 PLC、JSON 配置接入、控制台示例与文档。</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Mokode-dev/Zeus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mokode-dev/Zeus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
