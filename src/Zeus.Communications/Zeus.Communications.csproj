<Project Sdk="Microsoft.NET.Sdk">

  <!-- 传输层：串口、TCP/UDP 与虚拟通道。协议包应只依赖抽象，不直接依赖本程序集的具体类型。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Zeus</RootNamespace>
    <AssemblyName>Zeus.Communications</AssemblyName>
    <Description>Zeus 传输层：串口、TCP/UDP 客户端与可挂从站应答器的虚拟通道。</Description>
    <PackageDescription>Zeus 传输层：串口、TCP/UDP 客户端与可挂从站应答器的虚拟通道。</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zeus.Abstractions\Zeus.Abstractions.csproj" />
    <ProjectReference Include="..\Zeus.Core\Zeus.Core.csproj" />
    <ProjectReference Include="..\Zeus.Hosting\Zeus.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

</Project>
