<Project Sdk="Microsoft.NET.Sdk">

  <!-- Siemens S7 TCP 客户端、设备封装与内存虚拟 PLC。协议只依赖通道抽象，传输由 Communications 提供。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Zeus</RootNamespace>
    <AssemblyName>Zeus.Protocols.S7</AssemblyName>
    <Description>Zeus Siemens S7 TCP 客户端、设备封装与内存虚拟 PLC。</Description>
    <PackageDescription>Zeus Siemens S7 TCP 客户端、设备封装与内存虚拟 PLC。</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zeus.Abstractions\Zeus.Abstractions.csproj" />
    <ProjectReference Include="..\Zeus.Core\Zeus.Core.csproj" />
    <ProjectReference Include="..\Zeus.Hosting\Zeus.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
