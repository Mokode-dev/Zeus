<Project Sdk="Microsoft.NET.Sdk">

  <!-- 组合根：封装 Generic Host，向用户暴露 ZeusHost.Create 这一简单入口。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Zeus</RootNamespace>
    <AssemblyName>Zeus.Hosting</AssemblyName>
    <Description>Zeus 宿主：ZeusHost.Create、可再次启动的生命周期、运行中增删与周期采集循环。</Description>
    <PackageDescription>Zeus 宿主：ZeusHost.Create、可再次启动的生命周期、运行中增删与周期采集循环。</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zeus.Abstractions\Zeus.Abstractions.csproj" />
    <ProjectReference Include="..\Zeus.Core\Zeus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配置监视服务需要在构建完成后回调 IZeusHost，避免把访问器做成公开 API。 -->
    <InternalsVisibleTo Include="Zeus.Configuration" />
  </ItemGroup>

</Project>
