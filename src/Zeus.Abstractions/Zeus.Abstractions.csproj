    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Zeus</RootNamespace>
    <AssemblyName>Zeus.Abstractions</AssemblyName>
    <Description>Zeus 稳定契约：通道、设备、点表与宿主接口。不引用任何 UI 或传输实现。</Description>
    <PackageDescription>Zeus 稳定契约：通道、设备、点表与宿主接口。不引用任何 UI 或传输实现。</PackageDescription>
  </PropertyGroup>

</Project>
