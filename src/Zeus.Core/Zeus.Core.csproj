<Project Sdk="Microsoft.NET.Sdk">

  <!-- 运行时内核：通道状态机、设备基类与通用守卫，仍保持 UI 无关。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Zeus</RootNamespace>
    <AssemblyName>Zeus.Core</AssemblyName>
    <PackageId>Zeus.Runtime</PackageId>
    <Description>Zeus 运行时内核：通道状态机、设备基类与点表。UI 无关。</Description>
    <PackageDescription>Zeus 运行时内核：通道状态机、设备基类与点表。UI 无关。包标识为 Zeus.Runtime，因 nuget.org 上 Zeus.Core 已被占用。</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zeus.Abstractions\Zeus.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 宿主与配置监视需要内部日志作用域；测试访问内部通道订阅快照。 -->
    <InternalsVisibleTo Include="Zeus.Hosting" />
    <InternalsVisibleTo Include="Zeus.Configuration" />
    <InternalsVisibleTo Include="Zeus.Tests" />
  </ItemGroup>

</Project>
