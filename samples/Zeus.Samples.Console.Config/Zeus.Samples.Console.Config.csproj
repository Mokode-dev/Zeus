<Project Sdk="Microsoft.NET.Sdk">

  <!-- JSON 配置示例：从 zeus.json 装载虚拟从站与点表。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Zeus.Samples.Console.Config</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zeus.Configuration\Zeus.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Zeus.Hosting\Zeus.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="zeus.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
